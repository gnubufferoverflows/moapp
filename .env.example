# Public port used by Docker Compose.
MO_PORT=8080

# Leave empty when the frontend and API share the same origin.
# For separate static hosting, set this to the API's public URL at build time.
VITE_SYNC_BASE_URL=

# Comma-separated frontend origins allowed to call a separate API.
# Example: https://mo.example.com,https://www.example.com
ALLOWED_ORIGINS=

# Set to true only when running behind a trusted HTTPS reverse proxy.
TRUST_PROXY=false

# Local production-server settings (Docker uses /data instead).
PORT=8080
DATA_DIR=./data
